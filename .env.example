# =============================================
# PORTFOLIO - ENVIRONMENT CONFIGURATION
# =============================================
# Copy file này thành .env và điền giá trị thật
# KHÔNG COMMIT file .env vào Git

# --- MySQL ---
MYSQL_ROOT_PASSWORD=your_strong_root_password_here
MYSQL_DATABASE=portfolio_db
MYSQL_USER=portfolio_user
MYSQL_PASSWORD=your_strong_app_password_here
MYSQL_HOST=mysql
MYSQL_PORT=3306

# --- MySQL Exporter (Prometheus) ---
MYSQL_EXPORTER_PASSWORD=your_exporter_password_here

# --- phpMyAdmin ---
PMA_ARBITRARY=0
PMA_HOST=mysql
PMA_PORT=3306

# --- Grafana ---
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=your_grafana_password_here
GF_INSTALL_PLUGINS=

# --- Ứng dụng PHP ---
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost
APP_SECRET_KEY=your_random_32char_secret_key_here

# --- Admin mặc định (chỉ dùng lần đầu seed) ---
ADMIN_EMAIL=admin@portfolio.local
ADMIN_PASSWORD=Admin@2025!

# --- Upload ---
MAX_UPLOAD_SIZE_MB=5

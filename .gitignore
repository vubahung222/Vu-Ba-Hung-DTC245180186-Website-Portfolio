# =============================================
# .gitignore - Portfolio Đề 13
# =============================================

# --- Môi trường (KHÔNG COMMIT!) ---
.env
.env.local
*.env.local

# --- Upload files (dữ liệu người dùng) ---
app/uploads/avatars/*.jpg
app/uploads/avatars/*.jpeg
app/uploads/avatars/*.png
app/uploads/avatars/*.gif
app/uploads/avatars/*.webp
!app/uploads/avatars/.gitkeep

# --- SSL certs ---
# CHỈ ignore private key (.key) - bảo mật cao
# GIỮ public cert (.crt) - Nginx cần để chạy được
nginx/ssl/*.key
nginx/ssl/*.pem
# nginx/ssl/*.crt  ← KHÔNG ignore cert!

# --- Docker volumes (dữ liệu runtime) ---
mysql-data/
grafana-data/
prometheus-data/
loki-data/

# --- Node modules ---
node_modules/

# --- PHP cache ---
app/src/cache/
*.cache

# --- OS files ---
.DS_Store
Thumbs.db
desktop.ini
*.lnk

# --- IDE ---
.vscode/
.idea/
*.swp
*.swo
*.orig

# --- Backup files ---
*.sql.bak
*.sql.gz
backups/
# KHÔNG ignore *.sql (sẽ block mysql/init/*.sql scripts!)

# --- Python cache ---
__pycache__/
*.pyc
*.pyo

# --- Logs runtime ---
*.log

# --- Office temp files ---
~$*

